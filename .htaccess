PassengerEnabled on
PassengerAppRoot /home/wwjmerco/email/video/shorts-generator
PassengerPython /home/wwjmerco/email/video/shorts-generator/venv/bin/python3

RewriteEngine On

# Serve static files directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Route everything else to Passenger/Flask
RewriteRule ^(.*)$ /passenger_wsgi.py/$1 [QSA,L]
